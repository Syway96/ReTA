# ===== PostgreSQL 数据库连接（master 分支需要，main 分支无需）=====
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://chainlit_user:changeme@localhost:5432/chainlit_db

# ===== Chainlit 认证配置 =====
# 认证密钥（随机字符串即可，main 分支无需）
CHAINLIT_AUTH_SECRET=请替换为随机字符串
# 用户凭据，格式: "用户名:密码" 多用户用逗号分隔（main 分支无需）
AUTH_USERS=admin:changeme

# ===== LLM 配置 =====
LLM_PROVIDER=api                               # api 或 local
LLM_API_KEY=sk-your-deepseek-api-key           # API 密钥
LLM_API_BASE=https://api.deepseek.com          # API 地址
LLM_MODEL_NAME=deepseek-v4-flash               # 模型名称
LLM_REASONING_EFFORT=off                       # 思考模式: off / low / medium / high

# ===== 模型路径配置 =====
EMBEDDING_MODEL_PATH=D:/models/Qwen/Qwen3-Embedding-0.6B       # 本地嵌入模型路径
CROSS_ENCODER_MODEL_PATH=D:/models/BAAI/bge-reranker-base   # 本地重排序模型路径
